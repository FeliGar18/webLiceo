# Copie este archivo como .env.local para desarrollo. En Vercel, defina las
# variables en Project Settings > Environment Variables (no suba .env.local).

# --- PÚBLICA (se incrusta en el JavaScript del navegador al compilar) ---
# URL canónica del sitio, sin barra final. Se usa en metadatos, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.cl

# --- SECRETAS (solo servidor; nunca les ponga el prefijo NEXT_PUBLIC_) ---
# Clave de API de Resend (https://resend.com) para enviar el formulario de contacto.
# Si falta, el formulario muestra que aún no está habilitado y no envía nada.
RESEND_API_KEY=
# Buzón del liceo que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=
# Remitente: una dirección de un dominio verificado en Resend, p. ej. "Sitio web <formulario@dominio.cl>".
CONTACT_FROM_EMAIL=
